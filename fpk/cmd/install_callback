#!/bin/bash
# 安装后回调：幂等初始化运行时目录。
# payload 已编译进 Go 单二进制（//go:embed），无需额外拷入；
# 此处仅确保 var/etc 目录存在，真正的 config.json 由后端首次运行自动生成。

mkdir -p "$TRIM_PKGVAR" "$TRIM_PKGETC"
touch "$TRIM_PKGVAR/.installed"

# Windows fnpack 打包的权限位全 0666，必须补可执行位，否则 cmd/main 的 nohup 会 Permission denied。
chmod +x "$TRIM_APPDEST/server/fntvplus" 2>/dev/null || true

# 若发布包附带可覆盖用的 payload，则放到 var 目录（后端目前以内置嵌入为准，此处为扩展预留）。
# 注：app/ 目录内容解包后直接落在 TRIM_APPDEST 根，故 app/server/payload/... → $TRIM_APPDEST/server/payload/...
if [ -f "$TRIM_APPDEST/server/payload/fntv-plus.user.js" ]; then
  mkdir -p "$TRIM_PKGVAR/payload"
  cp "$TRIM_APPDEST/server/payload/fntv-plus.user.js" "$TRIM_PKGVAR/payload/fntv-plus.user.js"
fi

# ── 安装/升级向导端口配置落盘 ──
# fnOS 把向导字段以环境变量注入本脚本：wizard_service_port / wizard_upstream_port。
# 生命周期脚本每次都是新 shell，环境变量不跨调用保留 → 落盘到 $TRIM_PKGETC/wizard.env，
# 由 cmd/main 每次 start 时 source。
#
# 覆盖安装时的关键约定：wizard/upgrade 的 initValue 是固定默认值（不是真实的当前值），
# 用户若只是点「下一步」就会带着 22350/5666 覆盖掉他之前改过的端口。所以这里**以现有
# wizard.env 为底**，只有向导确实传了新值才覆盖对应项；没传就原样保留。
ENVFILE="$TRIM_PKGETC/wizard.env"

log="$(dirname "$TRIM_PKGVAR")/wizard_install.log"
[ -d "$TRIM_PKGVAR" ] && log="$TRIM_PKGVAR/wizard_install.log"
{
  echo "==== install_callback wizard vars ===="
  echo "wizard_service_port=${wizard_service_port:-<unset>}"
  echo "wizard_upstream_port=${wizard_upstream_port:-<unset>}"
  echo "existing wizard.env: $([ -f "$ENVFILE" ] && echo yes || echo no)"
} >> "$log" 2>&1

if [ -n "$wizard_service_port" ] || [ -n "$wizard_upstream_port" ]; then
  # 读回现有值作为缺省（防「向导传空/只传一项」把另一项抹掉）
  CUR_SVC=""
  CUR_UP=""
  if [ -f "$ENVFILE" ]; then
    # shellcheck disable=SC1090
    . "$ENVFILE" 2>/dev/null
    CUR_SVC="$FNTV_SERVICE_PORT"
    CUR_UP="$FNTV_UPSTREAM_PORT"
  fi

  NEW_SVC="${wizard_service_port:-$CUR_SVC}"
  NEW_UP="${wizard_upstream_port:-$CUR_UP}"

  {
    echo "# AniBox 安装/升级向导端口配置（由 cmd/install_callback 生成，供 cmd/main 启动读取）"
    echo "# 手动改动本文件后重启应用即可生效。"
    [ -n "$NEW_SVC" ] && echo "FNTV_SERVICE_PORT=$NEW_SVC"
    [ -n "$NEW_UP" ] && echo "FNTV_UPSTREAM_PORT=$NEW_UP"
  } > "$ENVFILE"
fi

# ── 桌面入口 ui/config 的 port 始终与「最终生效的服务端口」对齐 ──
# 必须**无条件**执行，不能只在本次向导传了值时做：
#   覆盖安装会重新解包 app.tgz，ui/config 被重置成包内静态值（22350），
#   而 TRIM_PKGETC/wizard.env 保留着用户改过的端口 → 后端听新端口、图标指旧端口。
# 最终生效端口口径与 cmd/main 一致：wizard.env 的 FNTV_SERVICE_PORT > 系统注入的
# TRIM_SERVICE_PORT > 包内 ui/config 现值（不动）。
EFF_SVC=""
if [ -f "$ENVFILE" ]; then
  # shellcheck disable=SC1090
  . "$ENVFILE" 2>/dev/null
  EFF_SVC="$FNTV_SERVICE_PORT"
fi
[ -z "$EFF_SVC" ] && EFF_SVC="$TRIM_SERVICE_PORT"

if [ -n "$EFF_SVC" ]; then
  # ui/config 位于 TRIM_APPDEST（app.tgz 解包处），desktop_uidir 取自 manifest。
  UI_DIR="ui"
  if [ -f "$TRIM_APPDEST/manifest" ]; then
    d=$(grep -E '^[[:space:]]*desktop_uidir[[:space:]]*=' "$TRIM_APPDEST/manifest" 2>/dev/null | head -1 | cut -d= -f2 | tr -d ' \r')
    [ -n "$d" ] && UI_DIR="$d"
  fi
  UICONF="$TRIM_APPDEST/$UI_DIR/config"
  if [ -f "$UICONF" ] && grep -q '"port"' "$UICONF"; then
    # 用 sed 就地改 port 值（JSON 结构简单且由打包器固定生成，不引入 jq 依赖）
    sed -i -E "s/\"port\"[[:space:]]*:[[:space:]]*\"[^\"]*\"/\"port\": \"$EFF_SVC\"/" "$UICONF" 2>>"$log" \
      && echo "ui/config port -> $EFF_SVC" >> "$log" 2>&1
  fi
fi

exit 0
