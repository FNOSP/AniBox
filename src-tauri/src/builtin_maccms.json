[
  {
    "name": "量子资源",
    "version": "1.0.0",
    "baseURL": "https://cj.lziapi.com",
    "searchMode": "api",
    "searchApiConfig": {
      "request": { "method": "GET", "url": "https://cj.lziapi.com/api.php/provide/vod", "query": { "ac": "videolist", "wd": "@keyword" } },
      "listPath": "$.list[*]",
      "namePath": "$.vod_name",
      "sourcePath": "$.vod_id"
    },
    "chapterMode": "api",
    "chapterApiConfig": {
      "request": { "method": "GET", "url": "https://cj.lziapi.com/api.php/provide/vod", "query": { "ac": "detail", "ids": "@source" } },
      "format": "delimited",
      "roadNamesPath": "$.list[*].vod_play_from",
      "roadEpisodesPath": "$.list[*].vod_play_url"
    }
  },
