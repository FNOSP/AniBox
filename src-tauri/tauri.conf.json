{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AniBox",
  "version": "0.1.0",
  "identifier": "com.anibox.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AniBox",
        "width": 1440,
        "height": 900,
        "center": true,
        "minWidth": 960,
        "minHeight": 640,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "shadow": false,
        "additionalBrowserArgs": "--autoplay-policy=no-user-gesture-required --disable-features=msWebOOUI,msPdfOOUI"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
